# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# Resend API key (https://resend.com). Without it, quote emails are logged
# to the server console instead of sent (useful in development).
RESEND_API_KEY=

# Sender address. The domain must be verified in Resend.
QUOTE_FROM_EMAIL="Airsol Website <website@airsolhvac.com>"

# Where quote requests are delivered. Defaults to sales@airsolhvac.com.
QUOTE_TO_EMAIL=sales@airsolhvac.com

# Folder for the JSONL copy of each quote request. Defaults to ./.data locally.
# On Vercel only /tmp is writable and it is NOT permanent; use a database for
# durable storage (see README, "Quote storage").
QUOTE_STORE_DIR=
